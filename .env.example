# Copie para .env e ajuste. Nunca commite o .env.
PORT=3000
# SQLite (padrao para dev). Caminho relativo a pasta prisma/.
DATABASE_URL="file:./dev.db"
# PostgreSQL (veja README): postgresql://usuario:senha@localhost:5432/monitoramento
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
JWT_EXPIRES_IN=1h
# Quem se cadastrar com este e-mail recebe o papel ADMIN
ADMIN_EMAIL=admin@exemplo.com
